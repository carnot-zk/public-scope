SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
NETWORK=devnet

# Your keeper Solana keypair in base58 — NEVER commit this value
KEEPER_KEYPAIR=<base58_private_key>

# Carnot backend base URL and key for /internal/* batch routes
CARNOT_API_URL=https://api.carnot.xyz
CARNOT_INTERNAL_API_KEY=<internal_api_key>
# Optional; if unset, defaults to getUsdtMint(NETWORK) from @carnot/sdk
USDT_MINT=caw3MghdwE1FXAtGF5rhKpqtyML4GAdHxknwNcRatpH

# Optional: comma-separated marketId:pythFeedIdHex (defaults match single-market btcusdt in config.ts)
# MARKETS_CONFIG=btcusdt:e62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43

SP1_PROVER_BINARY=../circuit/target/release/carnot
# SP1_PROVER=network
# SP1_PRIVATE_KEY=<succinct_network_private_key>
MIN_PROOF_WAIT_MS=90000
BATCH_WINDOW_SECS=900
BATCH_POLL_INTERVAL_MS=30000

REWARD_DB_PATH=~/.carnot-keeper/rewards.db
